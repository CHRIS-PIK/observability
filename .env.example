# Persistent data directory. Relative paths are resolved from the repository root.
DATA_ROOT=./data

# Docker networks used by the stack.
FRONTEND_NETWORK=frontend
MONITORING_NETWORK=monitoring

# Grafana credentials. Change the password before exposing Grafana externally.
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=admin

# Published host ports.
GRAFANA_PORT=3000
LOKI_PORT=3100
TEMPO_PORT=3200
PYROSCOPE_PORT=4040
ALLOY_PROFILE_PORT=4041
OTLP_GRPC_PORT=4317
OTLP_HTTP_PORT=4318
MIMIR_PORT=9009
ALLOY_UI_PORT=12345
